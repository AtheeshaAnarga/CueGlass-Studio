#!/usr/bin/env bash
set -euo pipefail

DEST_DIR="$HOME/Downloads/pathfinder-glass"
echo "==> Extracting CueGlass Studio (Pathfinder Glass) to $DEST_DIR..."
rm -rf "$DEST_DIR"
mkdir -p "$DEST_DIR"

base64 -D << 'EOF_TAR_B64' | tar -xz -C "$DEST_DIR"

EOF_TAR_B64

cd "$DEST_DIR"
chmod +x build-release.sh package-dmg.sh Build-and-Export-DMG.command
./package-dmg.sh
