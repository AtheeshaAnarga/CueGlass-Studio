#!/usr/bin/env bash
set -euo pipefail

echo "========================================================"
echo "  CueGlass Studio (Pathfinder Glass) — Native Builder"
echo "  Builds Pathfinder Glass.app (with AppIcon.icns) & DMG"
echo "========================================================"

WORK_DIR="$HOME/Desktop/PathfinderGlass-Build"
mkdir -p "$WORK_DIR"
cd "$WORK_DIR"

echo "-> Extracting Xcode Swift Package source..."
cat << 'EOF_TAR_B64' | base64 --decode > source.tar.gz

EOF_TAR_B64

tar -xzf source.tar.gz
rm -f source.tar.gz

chmod +x build-release.sh package-dmg.sh
./package-dmg.sh

echo ""
echo "-> Opening build output folder in Finder..."
open "$WORK_DIR/dist"
