#!/usr/bin/env bash
set -euo pipefail

echo "========================================================"
echo "  Pathfinder Glass (Universal Edition) DMG Builder"
echo "  Official Apple macOS 26 Tahoe Clear Liquid Glass"
echo "========================================================"

WORK_DIR="$HOME/Desktop/PathfinderGlass-Build"
mkdir -p "$WORK_DIR"
cd "$WORK_DIR"

echo "-> Extracting Xcode Swift Package source..."
cat << 'EOF_TAR_B64' | base64 --decode > source.tar.gz

EOF_TAR_B64

tar -xzf source.tar.gz
rm -f source.tar.gz

chmod +x build-release.sh
./build-release.sh

echo ""
echo "-> Opening build output folder in Finder..."
open "$WORK_DIR/dist"
